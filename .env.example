# Copy to .env at the repository root. Use disposable local credentials.
# Package commands must load this file; see dev/LOCAL_DEVELOPMENT.md.
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Local PostgreSQL from docker-compose.dev.yml (host port 5439).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=syncbeats
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5439/syncbeats
STUDIO_PORT=5555
# Set a unique password before starting the optional visualizer container.
ADMIN_PASSWORD=

# Replace with your own random value: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-local-secret

# Optional integrations: use your own development credentials.
# Email registration/verification/reset need Resend and a verified sender.
RESEND_API_KEY=
AUTH_FROM_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:4000/spotify/callback
RAPID_API_KEY=
RAPID_API_KEYS=
REDIS_URL=
