generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String            @id @default(cuid())
  name                       String
  email                      String            @unique
  passwordHash               String?           @map("password_hash")
  authProvider               String            @default("LOCAL") @map("auth_provider")
  googleId                   String?           @unique @map("google_id")
  emailVerifiedAt            DateTime?         @map("email_verified_at") @db.Timestamptz(6)
  emailVerificationTokenHash String?           @map("email_verification_token_hash")
  emailVerificationExpiresAt DateTime?         @map("email_verification_expires_at") @db.Timestamptz(6)
  passwordResetTokenHash     String?           @map("password_reset_token_hash")
  passwordResetExpiresAt     DateTime?         @map("password_reset_expires_at") @db.Timestamptz(6)
  createdAt                  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt                DateTime?         @map("last_login_at") @db.Timestamptz(6)
  ytAccessToken              String?           @map("yt_access_token") @db.Text
  ytRefreshToken             String?           @map("yt_refresh_token") @db.Text
  spotifyAccessToken         String?           @map("spotify_access_token") @db.Text
  spotifyRefreshToken        String?           @map("spotify_refresh_token") @db.Text
  settings                   Json?
  devices                    Device[]
  roomParticipants           RoomParticipant[]
  roomQueueItems             RoomQueueItem[]
  rooms                      Room[]
  searchHistory              SearchHistory[]
  listenHistory              ListenHistory[]
  playlists                  Playlist[]
  invitesSent                RoomInvite[]      @relation("InvitesSent")
  invitesReceived            RoomInvite[]      @relation("InvitesReceived")
  feedbacks                  UserFeedback[]

  @@map("users")
}

model Device {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  deviceKey  String   @map("device_key")
  name       String
  userAgent  String?  @map("user_agent")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceKey])
  @@index([userId])
  @@map("devices")
}


model Room {
  id               String            @id
  hostId           String            @map("host_id")
  trackUrl         String?           @map("track_url")
  playbackState    String            @default("IDLE") @map("playback_state")
  positionMs       BigInt            @default(0) @map("position_ms")
  shuffle          Boolean           @default(false)
  repeatMode       String            @default("off") @map("repeat_mode")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  endedAt          DateTime?         @map("ended_at") @db.Timestamptz(6)
  lastAccessedAt   DateTime          @default(now()) @map("last_accessed_at") @db.Timestamptz(6)
  roomParticipants RoomParticipant[]
  queueItems       RoomQueueItem[]
  host             User              @relation(fields: [hostId], references: [id], onDelete: Cascade)
  invites          RoomInvite[]

  @@index([hostId])
  @@index([endedAt], map: "idx_rooms_active")
  @@map("rooms")
}

model RoomQueueItem {
  id             String   @id @default(cuid())
  roomId         String   @map("room_id")
  uploaderUserId String   @map("uploader_user_id")
  trackUrl       String   @map("track_url")
  title          String
  artist         String?
  fileName       String   @map("file_name")
  mimeType       String   @map("mime_type")
  sizeBytes      BigInt   @map("size_bytes")
  queueIndex     Int      @map("queue_index")
  isCurrent      Boolean  @default(false) @map("is_current")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  uploader       User     @relation(fields: [uploaderUserId], references: [id], onDelete: Cascade)

  @@index([roomId, queueIndex])
  @@index([uploaderUserId])
  @@map("room_queue_items")
}

model RoomParticipant {
  roomId      String    @map("room_id")
  userId      String    @map("user_id")
  socketId    String    @map("socket_id")
  displayName String    @map("display_name")
  joinedAt    DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt      DateTime? @map("left_at") @db.Timestamptz(6)
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@map("room_participants")
}

model cached_tracks {
  id           String   @id
  youtube_id   String   @unique
  title        String
  s3_url       String
  requested_by String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([youtube_id], map: "idx_cached_tracks_youtube_id")
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  query     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("search_history")
}

model ListenHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  youtubeId String   @map("youtube_id")
  title     String
  artist    String?
  thumbnail String?
  playedAt  DateTime @default(now()) @map("played_at") @db.Timestamptz(6)
  songId    String?  @map("song_id") // Optional link to global Song catalog
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song      Song?    @relation(fields: [songId], references: [id], onDelete: SetNull)

  @@index([userId, playedAt(sort: Desc)])
  @@map("listen_history")
}

model Playlist {
  id          String          @id @default(cuid())
  userId      String          @map("user_id")
  name        String
  description String?
  coverUrl    String?         @map("cover_url")
  sourceType  String          @default("SYNCBEATS") @map("source_type") // SYNCBEATS | SPOTIFY | APPLE_MUSIC
  sourceId    String?         @map("source_id") // original spotify playlist ID
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks      PlaylistTrack[]

  @@index([userId])
  @@map("playlists")
}

// Global Song Catalog — shared across all users, like Spotify/Apple Music's internal DB
model Song {
  id String @id @default(cuid())

  // Core identity
  title  String
  artist String
  album  String?

  // Rich metadata
  albumArt    String? @map("album_art") // High-res album cover (from Spotify)
  duration    Int? // Duration in seconds
  releaseYear Int?    @map("release_year")
  genre       String?

  // Cross-platform source IDs
  spotifyId String? @unique @map("spotify_id") // Spotify track URI

  // YouTube resolution (populated by client-side or server-side scraper)
  youtubeId        String?   @map("youtube_id") // YouTube video ID
  youtubeThumbnail String?   @map("youtube_thumbnail") // YouTube HQ thumbnail URL
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  playlistTracks PlaylistTrack[]
  listenHistory  ListenHistory[]

  @@unique([title, artist]) // Deduplication key
  @@index([youtubeId])
  @@index([spotifyId])
  @@map("songs")
}

model PlaylistTrack {
  id         String  @id @default(cuid())
  playlistId String  @map("playlist_id")
  songId     String? @map("song_id") // Link to global Song catalog (nullable for backward compat)

  // Denormalized fields kept for backward compat & fast reads (mirrors Song fields)
  youtubeId String  @default("") @map("youtube_id")
  title     String
  artist    String?
  thumbnail String? // Will hold YouTubeThumbnail once resolved

  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song?    @relation(fields: [songId], references: [id], onDelete: SetNull)

  @@index([playlistId, position])
  @@index([songId])
  @@map("playlist_tracks")
}

model RoomInvite {
  id           String   @id @default(cuid())
  roomId       String   @map("room_id")
  inviterId    String   @map("inviter_id")
  inviteeId    String?  @map("invitee_id") // Optional for raw email invites
  inviteeEmail String?  @map("invitee_email") // The email address if inviteeId is null
  status       String   @default("PENDING")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  room    Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  inviter User  @relation("InvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User? @relation("InvitesReceived", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([roomId, inviteeId])
  @@index([inviteeId])
  @@index([inviteeEmail])
  @@map("room_invites")
}

model BeatEventsCache {
  spotifyId String   @id @map("spotify_id")
  events    Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  
  @@map("beat_events_cache")
}

model UserFeedback {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  rating     Int
  category   String   @default("general")
  comment    String?  @db.Text
  appVersion String?  @map("app_version")
  page       String?
  sessionId  String?  @map("session_id")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([rating])
  @@index([createdAt(sort: Desc)])
  @@index([category])
  @@map("user_feedback")
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("admin_audit_logs")
}


